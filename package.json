{
  "name": "bookone-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public source repository for independent BookOne QA; npm publication disabled",
  "packageManager": "pnpm@9.0.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test:guard": "node --test tests/infrastructure/target-policy.test.mjs",
    "product:prepare": "node scripts/prepare-product.mjs",
    "test:unit": "node scripts/verify-product.mjs && vitest run --config vitest.config.ts",
    "test:e2e:list": "node apps/e2e-runner/scripts/run-suite.mjs full -- --list",
    "test:e2e": "node apps/e2e-runner/scripts/run-suite.mjs",
    "catalog:sync": "node scripts/export-e2e-catalog.mjs && node apps/e2e-runner/scripts/generate-coverage.mjs",
    "check": "pnpm validate && pnpm test:guard"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "22.13.10",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "2.1.9",
    "xlsx": "0.18.5"
  }
}
