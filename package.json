{
  "name": "bookone-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public source repository for independent BookOne QA; npm publication disabled",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test:guard": "node --test tests/infrastructure/target-policy.test.mjs",
    "product:prepare": "node scripts/prepare-product.mjs",
    "test:archive-helpers": "node scripts/archive-helpers.mjs",
    "test:unit": "node scripts/verify-product.mjs && node scripts/fixtures/unit.mjs",
    "test:e2e:list": "node apps/e2e-runner/scripts/run-suite.mjs full -- --list",
    "test:e2e": "node apps/e2e-runner/scripts/run-suite.mjs",
    "agent:browse": "node apps/e2e-runner/scripts/agent-browse.mjs",
    "catalog:sync": "node scripts/catalog/sync-backup.mjs && node scripts/export-e2e-catalog.mjs && node apps/e2e-runner/scripts/generate-coverage.mjs",
    "check": "pnpm validate && pnpm test:guard && pnpm test:harness && pnpm test:runtime-guard && pnpm matrix:check && pnpm backup:plan:check && pnpm test:campaign-guard && pnpm rulebook:check && pnpm test:http-guard && pnpm workflows:check && pnpm test:workflow-governance && pnpm library:check && pnpm test:business-library && pnpm test:operator-queue && pnpm test:operator-action-guard && pnpm test:review43-guard && pnpm test:mission-v2516 && pnpm test:mission-v2516-02 && pnpm ux:check && pnpm test:ux-workbook && pnpm test:review54-controls && pnpm test:mission-light05 && pnpm test:mission-light08 && pnpm test:desktop-guard && pnpm test:rapid01",
    "test:harness": "node --test tests/infrastructure/batch-state.test.mjs tests/infrastructure/runtime-diagnostics.test.mjs",
    "test:sensitivity": "node scripts/verify-product.mjs && node --test tests/infrastructure/posting-sensitivity.test.mjs",
    "session:start": "node scripts/session.mjs",
    "batch:plan": "node scripts/batch/run.mjs plan",
    "batch:coverage": "node scripts/batch/coverage.mjs",
    "batch:run": "node scripts/batch/run.mjs run",
    "batch:resume": "node scripts/batch/run.mjs resume",
    "batch:export": "node scripts/batch/run.mjs export",
    "matrix:check": "node scripts/matrix.mjs check",
    "matrix:generate": "node scripts/matrix.mjs generate",
    "runtime:prepare": "node scripts/runtime/prepare.mjs",
    "runtime:run": "node scripts/runtime/run.mjs",
    "test:runtime-guard": "node --test tests/infrastructure/runtime-target.test.mjs",
    "backup:plan:check": "node --import tsx scripts/validate-backup-plan.mjs",
    "campaign:plan": "node scripts/campaign/run.mjs plan",
    "campaign:run": "node scripts/campaign/run.mjs run",
    "campaign:resume": "node scripts/campaign/run.mjs resume",
    "test:campaign-guard": "node --test tests/infrastructure/campaign-state.test.mjs",
    "rulebook:render": "node scripts/rulebook.mjs render",
    "rulebook:check": "node scripts/rulebook.mjs check",
    "test:embedded-sql": "vitest run --config vitest.embedded.config.ts",
    "test:http-guard": "node --test tests/infrastructure/http-target.test.mjs",
    "http:run": "node scripts/http/run.mjs",
    "workflows:render": "node scripts/workflows.mjs render",
    "workflows:check": "node scripts/workflows.mjs check",
    "workflows:plan": "node scripts/workflows.mjs plan",
    "test:workflow-governance": "node --test tests/infrastructure/workflow-governance.test.mjs",
    "library:render": "node scripts/business-library.mjs render",
    "library:check": "node scripts/business-library.mjs check",
    "library:plan": "node scripts/business-library.mjs plan",
    "test:business-library": "node --test tests/infrastructure/business-library.test.mjs",
    "queue": "node scripts/operator-queue.mjs",
    "action-guard": "node scripts/operator-action-guard.mjs",
    "test:operator-queue": "node --test tests/infrastructure/operator-queue.test.mjs",
    "test:operator-action-guard": "node --test tests/infrastructure/operator-action-guard.test.mjs tests/infrastructure/operator-browser-transport.test.mjs",
    "review:pr43": "node scripts/review43-source.mjs",
    "test:review43-guard": "node --test tests/infrastructure/review43-source.test.mjs",
    "retest:v2516": "node scripts/retest2516-source.mjs",
    "test:mission-v2516": "node --test tests/infrastructure/mission-v2516.test.mjs",
    "test:mission-v2516-02": "node --test tests/infrastructure/mission-v2516-02.test.mjs",
    "review:pr46": "node scripts/review46-source.mjs",
    "ux:render": "node scripts/ux-workbook.mjs render",
    "ux:check": "node scripts/ux-workbook.mjs check",
    "ux:plan": "node scripts/ux-workbook.mjs plan",
    "test:ux-workbook": "node --test tests/infrastructure/ux-workbook.test.mjs",
    "test:review54-controls": "node --test tests/infrastructure/review54-controls.test.mjs",
    "test:mission-light05": "node --test tests/infrastructure/mission-light05.test.mjs",
    "test:mission-light08": "node --test tests/infrastructure/mission-light08.test.mjs",
    "test:desktop-guard": "node --test tests/infrastructure/operator-desktop-cua.test.mjs",
    "test:rapid01": "node --test tests/infrastructure/rapid-cycle01.test.mjs tests/infrastructure/rapid-cycle01-run.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3",
    "@playwright/test": "1.51.1",
    "@types/node": "22.13.10",
    "drizzle-orm": "0.33.0",
    "drizzle-kit": "0.24.2",
    "postgres": "3.4.9",
    "fast-check": "4",
    "react": "19",
    "react-dom": "19",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "2.1.9",
    "xlsx": "0.18.5",
    "yaml": "2",
    "zod": "4.4.3"
  }
}
