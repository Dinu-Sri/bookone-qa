{
    "name":  "bookone-qa",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "description":  "Public source repository for independent BookOne QA; npm publication disabled",
    "packageManager":  "pnpm@9.0.0",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "scripts":  {
                    "validate":  "node scripts/validate.mjs",
                    "test:guard":  "node --test tests/infrastructure/target-policy.test.mjs",
                    "product:prepare":  "node scripts/prepare-product.mjs",
                    "test:archive-helpers":  "node scripts/archive-helpers.mjs",
                    "test:unit":  "node scripts/verify-product.mjs \u0026\u0026 vitest run --config vitest.config.ts",
                    "test:e2e:list":  "node apps/e2e-runner/scripts/run-suite.mjs full -- --list",
                    "test:e2e":  "node apps/e2e-runner/scripts/run-suite.mjs",
                    "agent:browse":  "node apps/e2e-runner/scripts/agent-browse.mjs",
                    "catalog:sync":  "node scripts/catalog/sync-backup.mjs \u0026\u0026 node scripts/export-e2e-catalog.mjs \u0026\u0026 node apps/e2e-runner/scripts/generate-coverage.mjs",
                    "check":  "pnpm validate \u0026\u0026 pnpm test:guard \u0026\u0026 pnpm test:harness \u0026\u0026 pnpm test:runtime-guard \u0026\u0026 pnpm matrix:check \u0026\u0026 pnpm backup:plan:check",
                    "test:harness":  "node --test tests/infrastructure/batch-state.test.mjs tests/infrastructure/runtime-diagnostics.test.mjs",
                    "test:sensitivity":  "node scripts/verify-product.mjs \u0026\u0026 node --test tests/infrastructure/posting-sensitivity.test.mjs",
                    "session:start":  "node scripts/session.mjs",
                    "batch:plan":  "node scripts/batch/run.mjs plan",
                    "batch:coverage":  "node scripts/batch/coverage.mjs",
                    "batch:run":  "node scripts/batch/run.mjs run",
                    "batch:resume":  "node scripts/batch/run.mjs resume",
                    "batch:export":  "node scripts/batch/run.mjs export",
                    "matrix:check":  "node scripts/matrix.mjs check",
                    "matrix:generate":  "node scripts/matrix.mjs generate",
                    "runtime:prepare":  "node scripts/runtime/prepare.mjs",
                    "runtime:run":  "node scripts/runtime/run.mjs",
                    "test:runtime-guard":  "node --test tests/infrastructure/runtime-target.test.mjs",
                    "backup:plan:check":  "node --import tsx scripts/validate-backup-plan.mjs"
                },
    "devDependencies":  {
                            "@electric-sql/pglite":  "0.3",
                            "@playwright/test":  "1.51.1",
                            "@types/node":  "22.13.10",
                            "drizzle-orm":  "0.33.0",
                            "drizzle-kit":  "0.24.2",
                            "postgres":  "3.4.9",
                            "fast-check":  "4",
                            "react":  "19",
                            "react-dom":  "19",
                            "tsx":  "4.19.3",
                            "typescript":  "5.7.3",
                            "vitest":  "2.1.9",
                            "xlsx":  "0.18.5",
                            "yaml":  "2",
                            "zod":  "4.4.3"
                        }
}
